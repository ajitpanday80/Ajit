# --- required in production -------------------------------------------------
SECRET_KEY=                 # long random string (JWT signing):  python -c "import secrets;print(secrets.token_urlsafe(64))"
MASTER_KEYS=                # comma-separated Fernet keys, newest first:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# --- optional ---------------------------------------------------------------
ANTHROPIC_API_KEY=          # only used for clients whose ai_policy is cloud_allowed
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
CORS_ORIGINS=
